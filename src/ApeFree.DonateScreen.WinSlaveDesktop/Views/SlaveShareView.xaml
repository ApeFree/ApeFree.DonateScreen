<UserControl x:Class="ApeFree.DonateScreen.WinSlaveDesktop.Views.SlaveShareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ApeFree.DonateScreen.WinSlaveDesktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="450"
             Background="#F3F3F3" FontFamily="Segoe UI, Microsoft YaHei">
    <UserControl.DataContext>
        <vm:SlaveShareViewModel x:Name="ViewModel" />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- 头部标题与描述 -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="屏幕与控制分享 (Slave)" FontSize="20" FontWeight="Bold" Foreground="#1E1E1E"/>
                <TextBlock Text="主动向指定 Master 端献出本地屏幕图像及键盘鼠标交互权限" FontSize="12" Foreground="#666666" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 连接目标配置卡片 -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="目标 Master 主机" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" Foreground="#333333"/>
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="IP 地址 / 域名" FontSize="12" Foreground="#777777" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding MasterHost, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="6,4" VerticalContentAlignment="Center" BorderBrush="#CCCCCC"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="端口号" FontSize="12" Foreground="#777777" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding MasterPort, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="6,4" VerticalContentAlignment="Center" BorderBrush="#CCCCCC"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="本机标识备注 (设备名)" FontSize="12" Foreground="#777777" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="6,4" VerticalContentAlignment="Center" BorderBrush="#CCCCCC"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 分享权限模式选择卡片 -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="分享权限模式 (细粒度解耦)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" Foreground="#333333"/>
                    
                    <RadioButton IsChecked="{Binding IsFullControl}" Margin="0,6,0,4" GroupName="ShareModeGroup">
                        <StackPanel Margin="4,-2,0,0">
                            <TextBlock Text="完全控制 (Full Control)" FontWeight="Medium" Foreground="#222222"/>
                            <TextBlock Text="同时分享屏幕画面与键盘鼠标控制权，Master 可完整远程操作" FontSize="11" Foreground="#888888"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton IsChecked="{Binding IsViewOnly}" Margin="0,6,0,0" GroupName="ShareModeGroup">
                        <StackPanel Margin="4,-2,0,0">
                            <TextBlock Text="仅观看屏幕 (View Only)" FontWeight="Medium" Foreground="#222222"/>
                            <TextBlock Text="只读分享本地屏幕，物理阻断并拒绝一切键盘鼠标控制指令" FontSize="11" Foreground="#888888"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- 性能与画质微调卡片 -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="画质与性能调节" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#333333"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最大捕获帧率 (FPS)" FontSize="12" Foreground="#555555"/>
                        <TextBlock Grid.Column="1" Text="{Binding MaxFps, StringFormat='{}{0} FPS'}" FontSize="12" FontWeight="SemiBold" Foreground="#0078D4"/>
                    </Grid>
                    <Slider Minimum="10" Maximum="60" Value="{Binding MaxFps}" SmallChange="5" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TurboJPEG 压缩质量" FontSize="12" Foreground="#555555"/>
                        <TextBlock Grid.Column="1" Text="{Binding JpegQuality, StringFormat='{}{0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="#0078D4"/>
                    </Grid>
                    <Slider Minimum="20" Maximum="95" Value="{Binding JpegQuality}" SmallChange="5" LargeChange="10" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="色彩深度与图像质量" FontSize="12" Foreground="#555555"/>
                    </Grid>
                    <ComboBox SelectedIndex="{Binding SelectedPixelFormatIndex}" Height="28" Margin="0,0,0,4">
                        <ComboBoxItem Content="RGB 24位真彩 (默认，无Alpha通道，推荐)"/>
                        <ComboBoxItem Content="RGB 16位高彩 (RGB565，极速低功耗省50%)"/>
                        <ComboBoxItem Content="BGRA 32位全彩 (含Alpha通道)"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 运行状态仪表盘卡片 -->
            <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,20" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="实时监控状态" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="#333333"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前状态:" Foreground="#777777"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="Medium" Foreground="#0078D4" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="实时帧率 / 码率:" Foreground="#777777"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentFps, StringFormat='{}{0} FPS | '}" Foreground="#333333">
                            <Bold><Run Text="{Binding CurrentBitrate}"/></Bold>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="捕获引擎:" Foreground="#777777"/>
                        <TextBlock Grid.Column="1" Text="{Binding EngineName}" Foreground="#333333"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 操作按钮栏 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="{Binding ActionButtonText}" Click="OnActionClicked" Width="170" Height="38" Background="#0078D4" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,12,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="紧急切断控制" Click="OnEmergencyClicked" Width="140" Height="38" Background="#D83B01" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
