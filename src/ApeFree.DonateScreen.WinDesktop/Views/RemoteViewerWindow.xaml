<Window x:Class="ApeFree.DonateScreen.WinDesktop.Views.RemoteViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="远程桌面交互视窗" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E"
        KeyDown="OnWindowKeyDown" KeyUp="OnWindowKeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDeviceTitle" Text="远程设备" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border x:Name="BadgeMode" Background="#107C41" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="TxtBadgeMode" Text="完全控制" Foreground="White" FontSize="11" FontWeight="Medium"/>
                    </Border>
                    <TextBlock x:Name="TxtFpsInfo" Text="FPS: 0" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtResolution" Text="1920x1080" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="强制刷新" Click="OnRefreshKeyFrameClicked" Height="26" Padding="10,0" Margin="0,0,8,0" Background="#3E3E42" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="复位按键" Click="OnResetInputClicked" Height="26" Padding="10,0" Margin="0,0,8,0" Background="#3E3E42" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Ctrl+Alt+Del" Click="OnSendCadClicked" Height="26" Padding="10,0" Margin="0,0,8,0" Background="#3E3E42" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnFullscreen" Content="全屏" Click="OnToggleFullscreenClicked" Height="26" Padding="10,0" Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 核心画面渲染容器 -->
        <Border Grid.Row="1" Background="#000000" ClipToBounds="True">
            <Grid>
                <Image x:Name="ImgDisplay"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       MouseMove="OnImageMouseMove"
                       MouseDown="OnImageMouseDown"
                       MouseUp="OnImageMouseUp"
                       MouseWheel="OnImageMouseWheel"
                       Cursor="Cross"/>

                <!-- 只读水印提示 -->
                <Border x:Name="BorderViewOnlyNotice" Background="#AA000000" CornerRadius="6" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Visibility="Collapsed">
                    <TextBlock Text="[只读模式] 键盘鼠标控制已禁用" Foreground="#FFD700" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#007ACC" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusTip" Text="就绪 - 点击画面内即可通过本地键盘鼠标直接操作远端" Foreground="White" FontSize="11"/>
                <TextBlock x:Name="TxtBitrate" HorizontalAlignment="Right" Text="0 KB/s" Foreground="#E0E0E0" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
