<Window x:Class="ApeFree.DonateScreen.WinDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ApeFree.DonateScreen.WinDesktop.ViewModels"
        xmlns:slaveViews="clr-namespace:ApeFree.DonateScreen.WinSlaveDesktop.Views;assembly=ApeFree.DonateScreen.WinSlaveDesktop"
        mc:Ignorable="d"
        Title="ApeFree.DonateScreen - 远程屏幕与控制管理系统" Height="680" Width="820"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" FontFamily="Segoe UI, Microsoft YaHei">
    <Window.DataContext>
        <vm:MasterViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid>
        <TabControl Background="Transparent" BorderThickness="0">
            <!-- 标签页 1：远程主控端 (Master) -->
            <TabItem Header="  远程桌面管理 (Master)  " FontSize="14" FontWeight="Medium">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 服务端监听控制卡片 -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="本地监听服务" FontWeight="Bold" FontSize="15" Foreground="#222222" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Border Background="#E5F3FF" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" Foreground="#0078D4" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="等待远程 Slave 端主动连入，接入的设备将自动出现在下方列表中" FontSize="12" Foreground="#777777"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="监听端口:" VerticalAlignment="Center" Foreground="#555555" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="30" VerticalContentAlignment="Center" BorderBrush="#CCCCCC"/>
                                </StackPanel>

                                <Button Content="{Binding ActionButtonText}" Click="OnToggleListenClicked" Width="140" Height="34" Background="#0078D4" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Slave 设备接入列表 -->
                    <Grid Grid.Row="1">
                        <!-- 列表区域 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSlaveDevices, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl ItemsSource="{Binding SlaveDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#E0E0E0" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 设备详情 -->
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Info.MachineName}" FontWeight="Bold" FontSize="15" Foreground="#1E1E1E" Margin="0,0,12,0"/>
                                                        <Border Background="#107C41" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Info.ShareMode}" Foreground="White" FontSize="11" FontWeight="Medium"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <TextBlock Text="网络地址: " Foreground="#888888" FontSize="12"/>
                                                        <TextBlock Text="{Binding RemoteAddress}" Foreground="#333333" FontSize="12" Margin="0,0,16,0"/>
                                                        <TextBlock Text="屏幕分辨率: " Foreground="#888888" FontSize="12"/>
                                                        <TextBlock Text="{Binding Info.DisplayWidth, StringFormat='{}{0}'}" Foreground="#333333" FontSize="12"/>
                                                        <TextBlock Text="x" Foreground="#333333" FontSize="12"/>
                                                        <TextBlock Text="{Binding Info.DisplayHeight, StringFormat='{}{0}'}" Foreground="#333333" FontSize="12"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <TextBlock Text="系统: " Foreground="#888888" FontSize="12"/>
                                                        <TextBlock Text="{Binding Info.OsVersion}" Foreground="#666666" FontSize="12" Margin="0,0,16,0"/>
                                                        <TextBlock Text="接入时间: " Foreground="#888888" FontSize="12"/>
                                                        <TextBlock Text="{Binding ConnectedTime, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#666666" FontSize="12"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 操作按钮 -->
                                                <Button Grid.Column="1" Content="开始控制" Click="OnControlSlaveClicked" Width="100" Height="34" VerticalAlignment="Center" Background="#107C41" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 空状态提示 -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                                Visibility="{Binding HasNoSlaveDevices, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                                <TextBlock Text="暂无 Slave 设备接入" FontSize="16" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="请在受控端 (WinSlaveDesktop) 输入本机的 IP 与监听端口，并点击【开始分享】即可在此显示" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 标签页 2：本机受控分享 (Slave) - 直接复用 WinSlaveDesktop 面板组件 -->
            <TabItem Header="  本机受控分享 (Slave)  " FontSize="14" FontWeight="Medium">
                <Grid>
                    <slaveViews:SlaveShareView HorizontalAlignment="Center" Margin="20"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
